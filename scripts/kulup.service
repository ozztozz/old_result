[Unit]
Description=Gunicorn daemon for Kulup Yonetim Django Project
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kulup_yonetim/swim_club_project
RuntimeDirectory=kulup
ExecStart=/home/ubuntu/kulup_yonetim/venv/bin/gunicorn \
    --access-logfile - \
    --workers 3 \
    --bind unix:/run/kulup/kulup.sock \
    swim_club_project.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
